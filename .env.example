# PUID/PGID must own data/ and config/ (run `id -u` / `id -g`); do not use 0 (root)
PUID=1000
PGID=1000
# Bind address for the Syncthing GUI (127.0.0.1 = local only; use a LAN IP to expose)
GUI_BIND=127.0.0.1
# The restic passphrase is NOT set here: it lives in ./secrets/restic_password (see README)
# RESTIC_PASSWORD="change-me!"
# Seconds between backups
BACKUP_INTERVAL=3600

# Backup browser UI (docker compose --profile browse up -d browser). Keep it local: it shows file contents
# and has no login. To reach it from elsewhere use an SSH tunnel, or set both of these deliberately.
BROWSER_BIND=127.0.0.1
# BROWSER_ALLOWED_HOSTS=127.0.0.1,localhost

# Optional chaining
# COMPOSE_FILE=docker-compose.yml:docker-compose.selinux.yml